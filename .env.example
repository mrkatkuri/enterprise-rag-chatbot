# Copy to .env and supply credentials. Never commit .env.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag-chatbot
PINECONE_NAMESPACE=local-development
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DENSE_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=6
RRF_K=60
# Set empty to disable hosted reranking.
RERANK_MODEL=bge-reranker-v2-m3
INDEX_CACHE_DIR=data/index
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=2000
CHAT_HISTORY_TURNS=6
